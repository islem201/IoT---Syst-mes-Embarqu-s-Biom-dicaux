  {
    "id": "tpl_kpi",
    "type": "ui-template",
    "z": "flux_sante_iot_01",
    "group": "grp_kpi",
    "page": "",
    "ui": "",
    "name": "Vue d'ensemble",
    "order": 1,
    "width": 12,
    "height": 0,
    "head": "",
    "format": "<template>\n  <div class=\"sk\">\n    <div class=\"sk-banner\" :class=\"'is-' + s.status\">\n      <v-icon class=\"sk-ico\" size=\"44\">{{ bannerIcon }}</v-icon>\n      <div class=\"sk-txt\">\n        <div class=\"sk-title\">{{ bannerTitle }}</div>\n        <div class=\"sk-sub\">{{ bannerSub }}</div>\n      </div>\n      <div class=\"sk-pill\" :class=\"s.online ? 'on' : 'off'\">\n        <span class=\"sk-dot\"></span>{{ s.online ? 'Capteurs en ligne' : 'Hors ligne depuis ' + s.ageS + ' s' }}\n      </div>\n    </div>\n\n    <div class=\"sk-panel\" :class=\"{ stale: !s.online }\">\n      <div class=\"sk-cell\" :class=\"'f-' + s.flags.bpm\">\n        <div class=\"sk-lbl\"><v-icon size=\"20\" :class=\"{ beat: s.bpm !== null }\">mdi-heart-pulse</v-icon>Rythme cardiaque</div>\n        <div class=\"sk-val\">{{ fmt(s.bpm, 0) }}<span class=\"sk-unit\">bpm</span></div>\n        <div class=\"sk-note\">{{ s.bpm === null ? 'Posez le doigt sur le capteur' : 'Plage normale de ' + s.seuils.bpmMin + ' à ' + s.seuils.bpmMax + ' bpm' }}</div>\n      </div>\n      <div class=\"sk-cell\" :class=\"'f-' + s.flags.spo2\">\n        <div class=\"sk-lbl\"><v-icon size=\"20\">mdi-water-percent</v-icon>Saturation en oxygène</div>\n        <div class=\"sk-val\">{{ fmt(s.spo2, 0) }}<span class=\"sk-unit\">%</span></div>\n        <div class=\"sk-note\">{{ s.spo2 === null ? 'Posez le doigt sur le capteur' : 'Minimum accepté : ' + s.seuils.spo2Min + ' %' }}</div>\n      </div>\n      <div class=\"sk-cell\" :class=\"'f-' + s.flags.accel\">\n        <div class=\"sk-lbl\"><v-icon size=\"20\">mdi-run-fast</v-icon>Accélération</div>\n        <div class=\"sk-val\">{{ fmt(s.accel, 2) }}<span class=\"sk-unit\">m/s²</span></div>\n        <div class=\"sk-note\">x {{ fmt(s.ax, 2) }}   y {{ fmt(s.ay, 2) }}   z {{ fmt(s.az, 2) }}</div>\n      </div>\n      <div class=\"sk-cell\" :class=\"'f-' + s.flags.err\">\n        <div class=\"sk-lbl\"><v-icon size=\"20\">mdi-bell-ring-outline</v-icon>Boîtier d'alarme</div>\n        <div class=\"sk-val sm\">{{ s.buzzer }}</div>\n        <div class=\"sk-note\">{{ s.buzzer === 'HORS_LIGNE' ? 'Boîtier injoignable' : (s.err ? 'Anomalie matérielle, code ' + s.err : 'Aucune anomalie matérielle') }}</div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return {\n      s: {\n        status: 'wait', alerts: [], online: true, ageS: 0, silenceLeft: 0,\n        flags: { bpm: 'none', spo2: 'none', accel: 'none', err: 'ok' },\n        bpm: null, spo2: null, accel: null, ax: null, ay: null, az: null,\n        err: 0, buzzer: '--', seuils: {}, rec: {}\n      }\n    }\n  },\n  computed: {\n    bannerIcon() {\n      return { wait: 'mdi-timer-sand', normal: 'mdi-shield-check', silenced: 'mdi-bell-off', alarm: 'mdi-alert-octagon' }[this.s.status] || 'mdi-help-circle'\n    },\n    bannerTitle() {\n      return { wait: 'En attente des mesures', normal: 'Paramètres normaux', silenced: 'Alarme coupée', alarm: 'Alerte en cours' }[this.s.status] || ''\n    },\n    bannerSub() {\n      const s = this.s\n      if (s.status === 'alarm' || s.status === 'silenced') {\n        let t = s.alerts.length ? s.alerts.join('   |   ') : \"Test de l'alarme\"\n        if (s.status === 'silenced') t += '   (réarmement dans ' + s.silenceLeft + ' s)'\n        return t\n      }\n      if (s.status === 'normal') return 'Toutes les mesures sont dans les seuils définis'\n      return 'Connexion au broker MQTT en cours'\n    }\n  },\n  methods: {\n    fmt(v, d) { return (v === null || v === undefined || isNaN(v)) ? '--' : Number(v).toFixed(d) }\n  },\n  mounted() {\n    this.$socket.on('msg-input:' + this.id, (msg) => {\n      if (msg && msg.payload && typeof msg.payload === 'object') this.s = msg.payload\n    })\n  },\n  unmounted() {\n    this.$socket.off('msg-input:' + this.id)\n  }\n}\n</script>\n\n<style>\n.sk { display: flex; flex-direction: column; gap: 14px; }\n.sk-banner { display: flex; align-items: center; gap: 16px; padding: 18px 22px; border-radius: 14px; color: #fff; background: #64748b; transition: background .4s; }\n.sk-banner.is-normal { background: #0f766e; }\n.sk-banner.is-silenced { background: #b45309; }\n.sk-banner.is-alarm { background: #b91c1c; animation: sk-pulse 1.2s infinite; }\n@keyframes sk-pulse { 0%, 100% { box-shadow: 0 0 0 0 rgba(220, 38, 38, .55); } 50% { box-shadow: 0 0 0 12px rgba(220, 38, 38, 0); } }\n.sk-txt { flex: 1; min-width: 0; }\n.sk-title { font-size: 1.4rem; font-weight: 700; }\n.sk-sub { font-size: .95rem; opacity: .92; margin-top: 2px; overflow-wrap: anywhere; }\n.sk-pill { display: flex; align-items: center; gap: 8px; padding: 6px 14px; border-radius: 999px; background: rgba(255, 255, 255, .18); font-size: .85rem; font-weight: 600; white-space: nowrap; }\n.sk-dot { width: 9px; height: 9px; border-radius: 50%; background: #fecaca; }\n.sk-pill.on .sk-dot { background: #86efac; }\n.sk-panel { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); border: 1px solid #e2e8f0; border-radius: 14px; overflow: hidden; transition: opacity .3s; }\n.sk-panel.stale { opacity: .45; }\n.sk-cell { padding: 18px 20px; border-right: 1px solid #e2e8f0; border-bottom: 1px solid #e2e8f0; margin: 0 -1px -1px 0; background: #fff; }\n.sk-cell.f-bad { background: #fef2f2; }\n.sk-lbl { display: flex; align-items: center; gap: 8px; font-size: .88rem; font-weight: 600; color: #475569; }\n.sk-val { font-size: 2.8rem; font-weight: 800; line-height: 1.1; margin-top: 8px; color: #0f172a; font-variant-numeric: tabular-nums; }\n.sk-val.sm { font-size: 1.6rem; line-height: 2.6rem; margin-top: 8px; }\n.sk-cell.f-ok .sk-val { color: #0f766e; }\n.sk-cell.f-bad .sk-val { color: #dc2626; }\n.sk-unit { font-size: 1rem; font-weight: 600; color: #64748b; margin-left: 6px; }\n.sk-note { margin-top: 6px; font-size: .82rem; color: #64748b; white-space: pre; }\n.beat { color: #dc2626; animation: sk-beat 1s infinite; }\n@keyframes sk-beat { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.3); } }\n@media (prefers-reduced-motion: reduce) { .sk-banner.is-alarm, .beat { animation: none; } }\n</style>\n",
    "storeOutMessages": true,
    "passthru": false,
    "resendOnRefresh": true,
    "templateScope": "local",
    "className": "",
    "x": 1130,
    "y": 460,
    "wires": [
      []
    ]
