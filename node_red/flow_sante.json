  {
    "id": "tpl_ctrl",
    "type": "ui-template",
    "z": "flux_sante_iot_01",
    "group": "grp_controle",
    "page": "",
    "ui": "",
    "name": "Commandes",
    "order": 1,
    "width": 12,
    "height": 0,
    "head": "",
    "format": "<template>\n  <div class=\"ck\">\n    <v-btn block size=\"large\" color=\"warning\" variant=\"flat\" prepend-icon=\"mdi-bell-off\" :disabled=\"!s.alarmOn\" @click=\"cmd('silence')\">Couper l'alarme</v-btn>\n    <v-btn block size=\"large\" color=\"error\" variant=\"tonal\" prepend-icon=\"mdi-bell-ring\" @click=\"cmd('test')\">Tester l'alarme (5 s)</v-btn>\n    <v-btn block size=\"large\" :color=\"s.rec.on ? 'error' : 'success'\" variant=\"flat\" :prepend-icon=\"s.rec.on ? 'mdi-stop-circle' : 'mdi-record-circle'\" @click=\"cmd('toggle_rec')\">{{ s.rec.on ? \"Arrêter l'enregistrement\" : \"Démarrer l'enregistrement\" }}</v-btn>\n\n    <div class=\"ck-rec\" :class=\"{ live: s.rec.on }\">\n      <div class=\"ck-rec-h\"><span class=\"ck-led\"></span>{{ s.rec.on ? 'Enregistrement en cours' : 'Enregistrement arrêté' }}</div>\n      <template v-if=\"s.rec.file\">\n        <div class=\"ck-row\"><span>Fichier</span><b>{{ fileName }}</b></div>\n        <div class=\"ck-row\"><span>Lignes écrites</span><b>{{ s.rec.rows }}</b></div>\n        <div class=\"ck-row\"><span>Début</span><b>{{ s.rec.startedAt }}</b></div>\n        <a class=\"ck-dl\" href=\"/sante/export\" target=\"_blank\">Télécharger le dernier CSV</a>\n      </template>\n      <div v-else class=\"ck-hint\">Une ligne par minute : BPM, SpO2, accélération et état de l'alarme.</div>\n    </div>\n\n    <div class=\"ck-hint\">Bouton physique : <b>1 appui</b> coupe l'alarme, <b>2 appuis rapides</b> démarrent ou arrêtent l'enregistrement.</div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() { return { s: { alarmOn: false, rec: { on: false, file: '', rows: 0, startedAt: '' } } } },\n  computed: {\n    fileName() { return (this.s.rec.file || '').split('/').pop() }\n  },\n  methods: {\n    cmd(topic) { this.send({ topic: topic, payload: topic }) }\n  },\n  mounted() {\n    this.$socket.on('msg-input:' + this.id, (msg) => {\n      if (msg && msg.payload && typeof msg.payload === 'object') this.s = msg.payload\n    })\n  },\n  unmounted() {\n    this.$socket.off('msg-input:' + this.id)\n  }\n}\n</script>\n\n<style>\n.ck { display: flex; flex-direction: column; gap: 12px; }\n.ck-rec { border: 1px solid #e2e8f0; border-radius: 12px; padding: 14px 16px; background: #f8fafc; }\n.ck-rec.live { border-color: #fca5a5; background: #fef2f2; }\n.ck-rec-h { display: flex; align-items: center; gap: 10px; font-weight: 700; color: #0f172a; margin-bottom: 8px; }\n.ck-led { width: 11px; height: 11px; border-radius: 50%; background: #94a3b8; }\n.ck-rec.live .ck-led { background: #dc2626; animation: ck-blink 1.2s infinite; }\n@keyframes ck-blink { 50% { opacity: .25; } }\n.ck-row { display: flex; justify-content: space-between; gap: 12px; font-size: .85rem; color: #475569; padding: 3px 0; }\n.ck-row b { color: #0f172a; font-weight: 600; text-align: right; overflow-wrap: anywhere; }\n.ck-dl { display: inline-block; margin-top: 8px; font-size: .88rem; font-weight: 600; color: #0369a1; text-decoration: underline; }\n.ck-hint { font-size: .82rem; color: #64748b; line-height: 1.4; }\n@media (prefers-reduced-motion: reduce) { .ck-rec.live .ck-led { animation: none; } }\n</style>\n",
