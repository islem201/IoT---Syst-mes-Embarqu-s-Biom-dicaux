  {
    "id": "fn_init",
    "type": "function",
    "z": "flux_sante_iot_01",
    "name": "Initialisation",
    "func": "// Exécuté au démarrage : initialise toute la mémoire du flow.\nconst DIR = env.get(\"SANTE_DIR\") || \"/home/pi/sante\";   // <-- dossier des fichiers (modifiable)\nconst DEFAULTS = { bpmMin: 45, bpmMax: 120, spo2Min: 92, accelMax: 18, accelMin: 3.5, snooze: 120, timeout: 30 };\n\nflow.set(\"dir\", DIR);\nflow.set(\"seuilsDefaults\", DEFAULTS);\nflow.set(\"seuils\", Object.assign({}, DEFAULTS));\nflow.set(\"etat\", { bpm: -1, spo2: -1, ax: null, ay: null, az: null, accel: null, errHw: 0, buzzer: \"--\", lastRx: Date.now() });\nflow.set(\"ctrl\", { alarmOn: false, silencedUntil: 0, testUntil: 0, lastCmdAt: 0, hadReal: false });\nflow.set(\"rec\", { on: false, file: \"\", rows: 0, startedAt: \"\", lastWrite: 0 });\nflow.set(\"last\", { alarmOn: false, silenced: false, alerts: [] });\n\nnode.status({ fill: \"green\", shape: \"dot\", text: DIR });\n// On demande ensuite la lecture des seuils sauvegardés\nreturn { topic: \"load\", filename: DIR + \"/seuils.json\" };\n",
