    "page": "",
    "ui": "",
    "name": "Seuils réglables",
    "order": 1,
    "width": 12,
    "height": 0,
    "head": "",
    "format": "<template>\n  <div class=\"tk\">\n    <div class=\"tk-grid\">\n      <div class=\"tk-sec\" v-for=\"g in groups\" :key=\"g.title\">\n        <div class=\"tk-h\"><v-icon size=\"20\">{{ g.icon }}</v-icon>{{ g.title }}</div>\n        <v-text-field v-for=\"fd in g.fields\" :key=\"fd.k\" v-model.number=\"f[fd.k]\" type=\"number\" :label=\"fd.label\" :suffix=\"fd.unit\" :step=\"fd.step\" variant=\"outlined\" density=\"compact\" hide-details></v-text-field>\n      </div>\n    </div>\n    <div class=\"tk-actions\">\n      <v-btn color=\"primary\" variant=\"flat\" size=\"large\" prepend-icon=\"mdi-content-save\" @click=\"apply\">Enregistrer les seuils</v-btn>\n      <v-btn variant=\"text\" size=\"large\" prepend-icon=\"mdi-restore\" @click=\"reset\">Valeurs par défaut</v-btn>\n      <v-chip v-if=\"note\" :color=\"ok ? 'success' : 'error'\" variant=\"tonal\" label>{{ note }}</v-chip>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return {\n      f: { bpmMin: 45, bpmMax: 120, spo2Min: 92, accelMax: 18, accelMin: 3.5, snooze: 120, timeout: 30 },\n      note: '', ok: true, timer: null,\n      groups: [\n        { title: 'Rythme cardiaque', icon: 'mdi-heart-pulse', fields: [\n          { k: 'bpmMin', label: 'BPM minimum', unit: 'bpm', step: 1 },\n          { k: 'bpmMax', label: 'BPM maximum', unit: 'bpm', step: 1 } ] },\n        { title: 'Oxygénation', icon: 'mdi-water-percent', fields: [\n          { k: 'spo2Min', label: 'SpO2 minimum', unit: '%', step: 1 } ] },\n        { title: 'Mouvement et chute', icon: 'mdi-run-fast', fields: [\n          { k: 'accelMax', label: 'Choc au-dessus de', unit: 'm/s²', step: 0.5 },\n          { k: 'accelMin', label: 'Chute libre sous', unit: 'm/s²', step: 0.5 } ] },\n        { title: 'Alarme et système', icon: 'mdi-cog-outline', fields: [\n          { k: 'snooze', label: \"Durée de coupure de l'alarme\", unit: 's', step: 10 },\n          { k: 'timeout', label: 'Perte de communication après', unit: 's', step: 5 } ] }\n      ]\n    }\n  },\n  methods: {\n    apply() { this.send({ topic: 'set', payload: Object.assign({}, this.f) }) },\n    reset() { this.send({ topic: 'reset' }) },\n    show(ok, text) {\n      this.ok = ok; this.note = text\n      clearTimeout(this.timer)\n      if (text) this.timer = setTimeout(() => { this.note = '' }, 5000)\n    }\n  },\n  mounted() {\n    this.$socket.on('msg-input:' + this.id, (msg) => {\n      const p = msg && msg.payload\n      if (!p || msg.topic !== 'seuils') return\n      if (p.ok && p.values) this.f = Object.assign({}, p.values)\n      this.show(p.ok, p.message)\n    })\n    this.$nextTick(() => this.send({ topic: 'get' }))\n  },\n  unmounted() {\n    this.$socket.off('msg-input:' + this.id)\n    clearTimeout(this.timer)\n  }\n}\n</script>\n\n<style>\n.tk { display: flex; flex-direction: column; gap: 18px; }\n.tk-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 22px; }\n.tk-sec { display: flex; flex-direction: column; gap: 12px; }\n.tk-h { display: flex; align-items: center; gap: 8px; font-weight: 700; color: #0f172a; }\n.tk-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }\n</style>\n",
