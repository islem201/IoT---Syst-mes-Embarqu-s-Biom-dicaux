  {
    "id": "fn_seuils",
    "type": "function",
    "z": "flux_sante_iot_01",
    "name": "Gestion des seuils",
    "func": "// Gestion des seuils : get / set / reset / load (lecture du fichier au démarrage)\nconst D = flow.get(\"seuilsDefaults\");\nif (!D) return null;\nconst cur = flow.get(\"seuils\") || D;\n\nconst RANGES = {\n    bpmMin:   [20, 100, \"BPM minimum\"],\n    bpmMax:   [80, 250, \"BPM maximum\"],\n    spo2Min:  [70, 100, \"SpO2 minimum\"],\n    accelMax: [10, 80,  \"Seuil de choc\"],\n    accelMin: [0, 9,    \"Seuil de chute libre\"],\n    snooze:   [5, 3600, \"Durée du silence\"],\n    timeout:  [5, 600,  \"Délai de perte de communication\"]\n};\nfunction validate(p) {\n    const out = {};\n    for (const k in RANGES) {\n        const [lo, hi, label] = RANGES[k];\n        const v = Number(p[k]);\n        if (p[k] === \"\" || p[k] === null || p[k] === undefined || !isFinite(v) || v < lo || v > hi)\n            return { error: label + \" : entrer une valeur entre \" + lo + \" et \" + hi };\n        out[k] = v;\n    }\n    if (out.bpmMin >= out.bpmMax) return { error: \"Le BPM minimum doit être inférieur au BPM maximum\" };\n    if (out.accelMin >= out.accelMax) return { error: \"Le seuil de chute libre doit être inférieur au seuil de choc\" };\n    return { values: out };\n}\nconst reply = (ok, message, values) => ({ topic: \"seuils\", payload: { ok: ok, message: message, values: values } });\nconst fileMsg = (v) => ({ filename: flow.get(\"dir\") + \"/seuils.json\", payload: JSON.stringify(v, null, 2) });\n\nswitch (msg.topic) {\n    case \"get\":\n        return [reply(true, \"\", cur), null, null];\n    case \"load\":\n        try {\n            const r = validate(Object.assign({}, D, JSON.parse(msg.payload)));\n            if (r.values) { flow.set(\"seuils\", r.values); node.status({ fill: \"green\", shape: \"dot\", text: \"seuils chargés\" }); }\n        } catch (err) {\n            node.status({ fill: \"yellow\", shape: \"ring\", text: \"fichier seuils illisible\" });\n        }\n        return [null, null, { topic: \"eval\" }];\n    case \"reset\":\n        flow.set(\"seuils\", Object.assign({}, D));\n        return [reply(true, \"Valeurs par défaut restaurées\", D), fileMsg(D), { topic: \"eval\" }];\n    case \"set\": {\n        const r = validate(msg.payload || {});\n        if (r.error) return [reply(false, r.error, cur), null, null];\n        flow.set(\"seuils\", r.values);\n        return [reply(true, \"Seuils enregistrés\", r.values), fileMsg(r.values), { topic: \"eval\" }];\n    }\n}\nreturn null;\n",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
