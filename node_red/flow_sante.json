  {
    "id": "fn_ingest",
    "type": "function",
    "z": "flux_sante_iot_01",
    "name": "Ingestion capteurs",
    "func": "// Reçoit les 4 topics capteurs, met à jour l'état et alimente les courbes.\nconst e = flow.get(\"etat\");\nif (!e) return null;                       // flow pas encore initialisé\nconst t = msg.topic;\nconst out = [null, null, null, null];      // [courbe BPM, courbe SpO2, courbe accel, moteur]\nconst n = Number(msg.payload);\n\nif (t === \"esp32/sante/bpm\") {\n    e.bpm = isFinite(n) ? n : -1;\n    if (e.bpm > 0) out[0] = { topic: \"BPM\", payload: e.bpm };            // -1 = pas de doigt\n} else if (t === \"esp32/sante/spo2\") {\n    e.spo2 = isFinite(n) ? n : -1;\n    if (e.spo2 > 0) out[1] = { topic: \"SpO2 (%)\", payload: e.spo2 };\n} else if (t === \"esp32/mpu6050/accel\") {\n    let d = msg.payload;\n    if (typeof d === \"string\") { try { d = JSON.parse(d); } catch (err) { d = null; } }\n    if (!d || ![d.x, d.y, d.z].every(v => typeof v === \"number\" && isFinite(v))) return null;\n    e.ax = d.x; e.ay = d.y; e.az = d.z;\n    e.accel = Math.round(Math.sqrt(d.x * d.x + d.y * d.y + d.z * d.z) * 100) / 100;   // repos ~ 9.81\n    out[2] = { topic: \"Accélération (m/s²)\", payload: e.accel };\n} else if (t === \"esp32/diagnostic/erreur\") {\n    const raw = String(msg.payload).trim();\n    e.errHw = (raw === \"\" || raw === \"0\" || /^ok$/i.test(raw)) ? 0 : raw;\n} else {\n    return null;\n}\n\ne.lastRx = Date.now();\nflow.set(\"etat\", e);\nout[3] = { topic: \"eval\" };\nreturn out;\n",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 470,
    "y": 160,
    "wires": [
      [
        "chart_bpm"
      ],
      [
        "chart_spo2"
      ],
      [
        "chart_accel"
      ],
      [
        "fn_engine"
      ]
    ]
  },
  {
    "id": "fn_button",
    "type": "function",
    "z": "flux_sante_iot_01",
    "name": "Bouton : SIMPLE = silence, DOUBLE = REC",
    "func": "// Deux topics arrivent ici :\n//  - esp32/alarme/etat   : état du boîtier (VEILLE / ACTIVE / ACQUITTEE / HORS_LIGNE)\n//  - esp32/alarme/bouton : événements du bouton physique, détectés par l'ESP32\n//        SIMPLE = 1er appui  -> coupe l'alarme\n//        DOUBLE = 2e appui rapide -> démarre / arrête l'enregistrement\nconst e = flow.get(\"etat\");\nif (!e) return null;\nconst raw = (typeof msg.payload === \"object\") ? JSON.stringify(msg.payload) : String(msg.payload);\nconst val = raw.replace(/[\"\\s]/g, \"\").toUpperCase();\n\nif (msg.topic === \"esp32/alarme/bouton\") {\n    if (msg.retain) return null;                 // jamais d'action sur un message retenu\n    if (val === \"SIMPLE\") return [{ topic: \"silence\" }, null];\n    if (val === \"DOUBLE\") return [null, { topic: \"toggle\" }];\n    return null;\n}\ne.buzzer = val.length > 24 ? val.slice(0, 24) + \"…\" : val;\nflow.set(\"etat\", e);\nreturn [{ topic: \"eval\" }, null];\n",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 520,
    "y": 320,
    "wires": [
      [
        "fn_engine"
      ],
      [
        "fn_recorder"
      ]
    ]
  },
