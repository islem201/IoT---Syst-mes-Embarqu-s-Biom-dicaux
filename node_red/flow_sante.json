  {
    "id": "fn_engine",
    "type": "function",
    "z": "flux_sante_iot_01",
    "name": "Moteur : seuils et alarme",
    "func": "// MOTEUR : évalue les seuils, gère l'alarme (ON/OFF, silence, test) et construit l'état du dashboard.\nconst now = Date.now();\nconst e = flow.get(\"etat\"), s = flow.get(\"seuils\"), c = flow.get(\"ctrl\"), rec = flow.get(\"rec\");\nif (!e || !s || !c || !rec) return null;\nconst t = msg.topic;\n\n// ---------- 1) Détection des anomalies ----------\nconst alerts = [];\nconst boxOff = (e.buzzer === \"HORS_LIGNE\");\nconst fl = { bpm: \"none\", spo2: \"none\", accel: \"none\", err: (e.errHw || boxOff) ? \"bad\" : \"ok\" };\n\nif (e.bpm > 0) {\n    fl.bpm = \"ok\";\n    if (e.bpm < s.bpmMin)      { fl.bpm = \"bad\"; alerts.push(\"Rythme cardiaque trop bas : \" + e.bpm + \" bpm\"); }\n    else if (e.bpm > s.bpmMax) { fl.bpm = \"bad\"; alerts.push(\"Rythme cardiaque trop élevé : \" + e.bpm + \" bpm\"); }\n}\nif (e.spo2 > 0) {\n    fl.spo2 = \"ok\";\n    if (e.spo2 < s.spo2Min)    { fl.spo2 = \"bad\"; alerts.push(\"SpO2 basse : \" + e.spo2 + \" %\"); }\n}\nif (e.accel !== null) {\n    fl.accel = \"ok\";\n    if (e.accel > s.accelMax)      { fl.accel = \"bad\"; alerts.push(\"Choc ou chute détecté : \" + e.accel + \" m/s²\"); }\n    else if (e.accel < s.accelMin) { fl.accel = \"bad\"; alerts.push(\"Chute libre détectée : \" + e.accel + \" m/s²\"); }\n}\nif (e.errHw) alerts.push(\"Anomalie matérielle (code \" + e.errHw + \")\");\nif (boxOff) alerts.push(\"Boîtier d'alarme hors ligne\");\n\nconst ageS = Math.round((now - e.lastRx) / 1000);\nconst online = ageS <= s.timeout;\nif (!online) alerts.push(\"Aucune donnée reçue depuis \" + ageS + \" s\");\n\nconst real = alerts.length > 0;\n\n// ---------- 2) Actions utilisateur ----------\nif (t === \"silence\" && c.alarmOn) {\n    if (real) c.silencedUntil = now + s.snooze * 1000;   // silence temporaire : réarmement après \"snooze\" s\n    c.testUntil = 0;\n}\nif (t === \"test\") c.testUntil = now + 5000;\n\nconst test = now < c.testUntil;\nif (!real && !test) c.silencedUntil = 0;                 // retour à la normale : on réarme\nconst silenced = real && now < c.silencedUntil;\nconst alarmOn = (real && !silenced) || test;\n\n// ---------- 3) Commande vers l'ESP32 Pilotage (uniquement sur changement + rappel toutes les 30 s) ----------\nlet cmd = null;\nif (alarmOn !== c.alarmOn || (alarmOn && now - c.lastCmdAt > 30000)) {\n    cmd = { payload: alarmOn ? \"ON\" : \"OFF\" };\n    c.lastCmdAt = now;\n}\n\n// ---------- 4) Notification dashboard ----------\nlet notif = null;\nif (real && !c.hadReal) notif = { payload: \"🚨 ALERTE : \" + alerts.join(\" | \"), color: \"#dc2626\" };\nelse if (!real && c.hadReal) notif = { payload: \"✅ Retour à la normale\", color: \"#16a34a\" };\nc.hadReal = real;\nc.alarmOn = alarmOn;\n\nflow.set(\"ctrl\", c);\nflow.set(\"last\", { alarmOn: alarmOn, silenced: silenced, alerts: alerts });\n\n// ---------- 5) État complet envoyé au dashboard ----------\nconst ui = {\n    status: alarmOn ? \"alarm\" : (silenced ? \"silenced\" : (e.lastRx ? \"normal\" : \"wait\")),\n    alerts: alerts, flags: fl, online: online, ageS: ageS,\n    bpm: e.bpm > 0 ? e.bpm : null,\n    spo2: e.spo2 > 0 ? e.spo2 : null,\n    accel: e.accel, ax: e.ax, ay: e.ay, az: e.az,\n    err: e.errHw, buzzer: e.buzzer,\n    alarmOn: alarmOn, silenced: silenced,\n    silenceLeft: silenced ? Math.ceil((c.silencedUntil - now) / 1000) : 0,\n    test: test, seuils: s,\n    rec: { on: rec.on, file: rec.file, rows: rec.rows, startedAt: rec.startedAt }\n};\n\nnode.status(alarmOn ? { fill: \"red\", shape: \"dot\", text: \"ALARME\" } :\n            silenced ? { fill: \"yellow\", shape: \"ring\", text: \"silence\" } :\n                       { fill: \"green\", shape: \"dot\", text: \"normal\" });\n\nreturn [cmd, { topic: \"state\", payload: ui }, notif];\n",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 800,
    "y": 240,
    "wires": [
      [
        "mqtt_out_alarme"
      ],
      [
        "tpl_kpi",
        "tpl_ctrl"
      ],
      [
        "ui_notify"
      ]
    ]
  },
  {
    "id": "fn_recorder",
    "type": "function",
    "z": "flux_sante_iot_01",
    "name": "Enregistrement CSV (1 ligne / min)",
    "func": "// ENREGISTREMENT CSV : 1 ligne par minute tant que l'enregistrement est actif.\nconst rec = flow.get(\"rec\");\nif (!rec) return null;\nconst dir = flow.get(\"dir\");\nconst HEADER = \"horodatage;bpm;spo2;accel_x;accel_y;accel_z;accel_norme_ms2;etat_alarme;alertes;code_erreur_materiel\";\nconst stamp = (d) => d.toLocaleString(\"sv-SE\");        // 2026-11-24 14:03:05 (heure locale)\nconst num = (x) => (typeof x === \"number\" && isFinite(x)) ? String(Math.round(x * 100) / 100) : \"\";\n\nfunction row() {\n    const e = flow.get(\"etat\") || {};\n    const l = flow.get(\"last\") || {};\n    const etat = l.alarmOn ? \"ALARME\" : (l.silenced ? \"SILENCE\" : \"NORMAL\");\n    return [\n        stamp(new Date()),\n        e.bpm > 0 ? e.bpm : \"\",\n        e.spo2 > 0 ? e.spo2 : \"\",\n        num(e.ax), num(e.ay), num(e.az), num(e.accel),\n        etat,\n        (l.alerts || []).join(\" | \").replace(/;/g, \",\"),\n        String(e.errHw || 0).replace(/;/g, \",\")\n    ].join(\";\");\n}\n\nif (msg.topic === \"toggle\" || msg.topic === \"toggle_rec\") {\n    if (!rec.on) {                                      // ---- DÉMARRAGE\n        const now = new Date();\n        const f = stamp(now).replace(\" \", \"_\").replace(/:/g, \"-\");\n        const r = { on: true, file: dir + \"/mesures_\" + f + \".csv\", rows: 1, startedAt: stamp(now), lastWrite: Date.now() };\n        flow.set(\"rec\", r);\n        return [\n            { filename: r.file, payload: HEADER + \"\\n\" + row() },\n            { topic: \"eval\" },\n            { payload: \"⏺ Enregistrement démarré (1 mesure par minute)\", color: \"#16a34a\" }\n        ];\n    }\n    const line = row();                                 // ---- ARRÊT\n    rec.on = false;\n    rec.rows += 1;\n    flow.set(\"rec\", rec);\n    return [\n        { filename: rec.file, payload: line },\n        { topic: \"eval\" },\n        { payload: \"⏹ Enregistrement terminé : \" + rec.rows + \" lignes\", color: \"#475569\" }\n    ];\n}\n\nif (msg.topic === \"tick\" && rec.on && Date.now() - rec.lastWrite >= 60000) {\n    rec.lastWrite = Date.now();\n    rec.rows += 1;\n    flow.set(\"rec\", rec);\n    return [{ filename: rec.file, payload: row() }, null, null];\n}\nreturn null;\n",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 820,
    "y": 400,
    "wires": [
      [
        "file_csv"
      ],
      [
        "fn_engine"
      ],
      [
        "ui_notify"
      ]
    ]
  },
