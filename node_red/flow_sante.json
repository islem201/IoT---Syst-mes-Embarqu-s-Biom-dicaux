    {
        "id": "fn_prep_sante_chart_v4",
        "type": "function",
        "z": "flux_sante_iot_v4",
        "name": "Formatage Courbe Santé",
        "func": "let val = Number(msg.payload);\nif (isNaN(val) || val <= 0) {\n    return null;\n}\nif (msg.topic.includes(\"bpm\")) {\n    msg.topic = \"Rythme Cardiaque (BPM)\";\n} else if (msg.topic.includes(\"spo2\")) {\n    msg.topic = \"Saturation SpO2 (%)\";\n}\nmsg.payload = val;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 450,
        "y": 120,
        "wires": [
            [
                "chart_sante_bpm_spo2_v4"
            ]
        ]
    },
    {
        "id": "fn_calcul_norme_accel_v4",
        "type": "function",
        "z": "flux_sante_iot_v4",
        "name": "Norme Accélération (m/s²)",
        "func": "let d = msg.payload;\nif (typeof d === \"string\") {\n    try { d = JSON.parse(d); } catch(e) { return null; }\n}\nif (d && typeof d.x === \"number\" && typeof d.y === \"number\" && typeof d.z === \"number\") {\n    let norme = Math.sqrt(d.x * d.x + d.y * d.y + d.z * d.z);\n    norme = Math.round(norme * 100) / 100;\n    return {\n        topic: \"Accélération Totale (m/s²)\",\n        payload: norme\n    };\n}\nreturn null;",
        "outputs": 1,
        "noerr": 0,
        "x": 450,
        "y": 240,
        "wires": [
            [
                "chart_accel_mpu_v4",
                "fn_diagnostic_seuils_v4"
            ]
        ]
    },
