    {
        "id": "fn_diagnostic_seuils_v4",
        "type": "function",
        "z": "flux_sante_iot_v4",
        "name": "Diagnostic Seuils & Déclenchement Alarme",
        "func": "let etat = context.get(\"etat\") || {\n    bpm: -1,\n    spo2: -1,\n    accel: 9.81,\n    errHw: 0\n};\n\nlet val = Number(msg.payload);\n\nif (msg.topic === \"esp32/sante/bpm\") etat.bpm = val;\nelse if (msg.topic === \"esp32/sante/spo2\") etat.spo2 = val;\nelse if (msg.topic === \"Accélération Totale (m/s²)\") etat.accel = val;\nelse if (msg.topic === \"esp32/diagnostic/erreur\") etat.errHw = val;\n\ncontext.set(\"etat\", etat);\n\nlet alertes = [];\n\nif (etat.bpm > 0 && (etat.bpm < 45 || etat.bpm > 120)) {\n    alertes.push(\"BPM critique : \" + etat.bpm + \" bpm\");\n}\nif (etat.spo2 > 0 && etat.spo2 < 92) {\n    alertes.push(\"SpO2 basse : \" + etat.spo2 + \" %\");\n}\nif (etat.accel > 18.0) {\n    alertes.push(\"Choc / Chute détectée (\" + etat.accel + \" m/s²)\");\n} else if (etat.accel < 3.5) {\n    alertes.push(\"Chute libre détectée (\" + etat.accel + \" m/s²)\");\n}\nif (etat.errHw !== 0) {\n    alertes.push(\"Anomalie système (Code \" + etat.errHw + \")\");\n}\n\nlet msgCmdAlarme = null;\nlet msgDashboard = {};\n\nif (alertes.length > 0) {\n    msgCmdAlarme = { topic: \"esp32/alarme/commande\", payload: \"ON\" };\n    msgDashboard.payload = \"🚨 ALERTE : \" + alertes.join(\" | \");\n} else {\n    msgDashboard.payload = \"✅ PARAMÈTRES NORMAUX (BPM: \" + (etat.bpm > 0 ? etat.bpm : \"--\") + \", SpO2: \" + (etat.spo2 > 0 ? etat.spo2 + \"%\" : \"--\") + \", Accel: \" + etat.accel + \" m/s²)\";\n}\n\nreturn [msgCmdAlarme, msgDashboard];",
        "outputs": 2,
        "noerr": 0,
        "x": 500,
        "y": 320,
        "wires": [
            [
                "mqtt_out_alarme_cmd_v4",
                "debug_alarme_v4"
            ],
            [
                "ui_text_diagnostic_v4"
            ]
        ]
    },
